{
  "name": "grafana-to-free-mobile",
  "version": "1.0.0",
  "description": "Receives Grafana webhooks and forwards them as SMS via Free Mobile API",
  "type": "module",
  "scripts": {
    "start": "bun run index.ts",
    "dev": "bun run --watch index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker build -t grafana-to-free-mobile --platform linux/amd64 .",
    "docker:publish": "docker tag grafana-to-free-mobile:latest ghcr.io/augustinbegue/grafana-to-free-mobile:latest && docker push ghcr.io/augustinbegue/grafana-to-free-mobile:latest"
  },
  "keywords": [
    "grafana",
    "webhook",
    "sms",
    "alerts"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  }
}
